/node_modules
/.next
/out
/build
/storybook-static
/test-results
/playwright-report
.DS_Store
*.pem
.env*
/coverage
next-env.d.ts
tsconfig.tsbuildinfo
.fuse_hidden*

# Per-machine session checkpoints written by .claude/hooks/write-handoff.sh
.claude/session-log/

# Per-machine Claude Code overrides. `settings.json` is the SHARED contract
# (hooks, permissions) and stays in git; this one carries machine-specific
# values — e.g. a Windows box whose Claude Code session PATH does not include
# `C:\Program Files\nodejs`, so every hook died on "npm: command not found".
# Absolute local paths must never reach the shared file.
.claude/settings.local.json

# Playwright MCP capture artifacts (console logs / page dumps from spec screenshot runs)
.playwright-mcp/
# yco-spec downscaled review copies (regenerated on every capture; PNG is canonical)
specs/storyboards/**/screenshots/_review/

# Capture fixtures — generated on demand by each storyboard capture script
# (deterministically seeded), never edited by hand. One is a 6 MB JPEG whose
# only job is to exceed the 5 MB attachment cap.
specs/storyboards/*/_fixtures/
